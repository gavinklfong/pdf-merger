                    <item>
                        <widget class="QPushButton" name="remove_all_btn">
                            <property name="text">
                                <string>Remove All</string>
                            </property>
                        </widget>
                    </item>

                    <item>
                        <spacer name="horizontalSpacer">
                            <property name="orientation">
                                <enum>Qt::Horizontal</enum>
                            </property>
                            <property name="sizeHint" stdset="0">
                                <size>
                                    <width>40</width>
                                    <height>20</height>
                                </size>
                            </property>
                        </spacer>
                    </item>

